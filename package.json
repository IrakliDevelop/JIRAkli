{
  "name": "jirakli",
  "version": "0.1.0",
  "description": "A lightweight, self-hosted ticket tracking system",
  "private": true,
  "scripts": {
    "dev": "pnpm build:shared && concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "dev:server": "pnpm --filter server start:dev",
    "dev:client": "pnpm --filter client start",
    "build": "pnpm --filter shared build && pnpm --filter server build && pnpm --filter client build",
    "build:shared": "pnpm --filter shared build",
    "build:server": "pnpm --filter server build",
    "build:client": "pnpm --filter client build",
    "test": "pnpm -r test",
    "test:server": "pnpm --filter server test",
    "test:client": "pnpm --filter client test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter server drizzle-kit generate",
    "db:migrate": "cd packages/server && pnpm tsx src/database/migrate.ts"
  },
  "keywords": [
    "ticket-tracking",
    "project-management",
    "self-hosted"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
